# KinderFlow — development environment template
#
# Copy to `.env` at the repository root and adjust only if a port collides:
#     cp .env.example .env
#
# `.env` is gitignored. `.env.example` is the authoritative inventory
# (Sprint 0 Guide 2.2) and is committed.
#
# EVERY VALUE HERE IS A DEV-ONLY FAKE. Nothing in this file is, or may become,
# a real credential. Staging and production read from the Coolify secret store
# only (Blueprint 9) — never from a committed file.

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=kinderflow

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Superuser, used only by the container entrypoint to bootstrap the database
# and the M-000 roles. The application never connects as this role.
KF_POSTGRES_USER=postgres
KF_POSTGRES_PASSWORD=dev_only_postgres
KF_POSTGRES_DB=kf_dev
KF_POSTGRES_PORT=5432

# M-000 least-privilege roles (Blueprint 4). Each has a distinct password so a
# leaked one does not grant the others' rights — the same discipline as prod.
#   kf_api           runtime role. NO BYPASSRLS, cannot create tables.
#                    RLS is the engine-level backstop (ADR-008).
#   kf_worker        background jobs, same trust level as kf_api.
#   kf_migrator      owns the schema; the only role that may DDL.
#   kf_audit_writer  INSERT-only on the audit tables (append-only chain).
KF_DB_API_PASSWORD=dev_only_api
KF_DB_WORKER_PASSWORD=dev_only_worker
KF_DB_MIGRATOR_PASSWORD=dev_only_migrator
KF_DB_AUDIT_WRITER_PASSWORD=dev_only_audit_writer

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
KF_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mailpit — captures all outbound dev email; nothing leaves the machine
# ---------------------------------------------------------------------------
KF_MAILPIT_SMTP_PORT=1025
KF_MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# MinIO — S3-compatible object storage
# ---------------------------------------------------------------------------
KF_MINIO_ROOT_USER=kf_dev_minio
KF_MINIO_ROOT_PASSWORD=dev_only_minio_password
KF_MINIO_API_PORT=9000
KF_MINIO_CONSOLE_PORT=9001
KF_S3_BUCKET_MEDIA=kf-media
KF_S3_BUCKET_BACKUPS=kf-backups

# ---------------------------------------------------------------------------
# pgAdmin — optional, only starts with `--profile tools`
# ---------------------------------------------------------------------------
KF_PGADMIN_EMAIL=dev@kinderflow.local
KF_PGADMIN_PASSWORD=dev_only_pgadmin
KF_PGADMIN_PORT=5050

# ===========================================================================
# Connection strings for apps running ON THE HOST
#
# Apps are deliberately not containerized in dev, so they hot-reload
# (Sprint 0 Guide 2.1). These point the host at the compose stack above. They
# are derived from the values already set — if you change a port, change it
# here too.
#
# Nothing consumes these yet: the NestJS app arrives with KF-S0-API-001 and
# Prisma with KF-S0-API-003. They are listed now so the stack is usable the
# moment those land.
# ===========================================================================
KF_DATABASE_URL=postgresql://kf_api:dev_only_api@localhost:5432/kf_dev?schema=public
KF_DATABASE_MIGRATION_URL=postgresql://kf_migrator:dev_only_migrator@localhost:5432/kf_dev?schema=public
KF_REDIS_URL=redis://localhost:6379

KF_S3_ENDPOINT=http://localhost:9000
KF_S3_REGION=us-east-1
KF_S3_ACCESS_KEY_ID=kf_dev_minio
KF_S3_SECRET_ACCESS_KEY=dev_only_minio_password
KF_S3_FORCE_PATH_STYLE=true

KF_SMTP_HOST=localhost
KF_SMTP_PORT=1025
KF_SMTP_SECURE=false
KF_SMTP_FROM=no-reply@kinderflow.local

# ---------------------------------------------------------------------------
# Not yet defined — deliberately absent
#
# KF_JWT_*  (key pair paths)        -> KF-S0-API-001
# KF_AI_*   (LLM provider config)   -> Sprint 4, blocked on founder decision F2
# NEXT_PUBLIC_KF_API_URL            -> KF-S0-FE-001
#
# These are named in Sprint 0 Guide 2.2 but their shape is decided by the tasks
# that introduce them. Inventing values here would be premature design, and a
# config module that fail-fasts (Guide 2.2) would then be validating fiction.
# ---------------------------------------------------------------------------
